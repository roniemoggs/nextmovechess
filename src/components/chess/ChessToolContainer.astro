---
import ChessEngineTool from '../ChessEngineTool';
import { getLangFromUrl } from '../../i18n/utils';
import { getChessToolTranslations } from '../../i18n/chessTool';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  initialFen?: string;
  isEmbedded?: boolean;
  lang?: SupportedLanguage;
}

const {
  initialFen,
  isEmbedded = false,
  lang = getLangFromUrl(Astro.url),
} = Astro.props;

const t = getChessToolTranslations(lang);
---

<div class="w-full min-h-[620px] transition-all">
  <ChessEngineTool client:only="react" initialFen={initialFen} isEmbedded={isEmbedded} lang={lang}>
    <div slot="fallback" class="w-full max-w-5xl mx-auto min-h-[580px] bg-[#0c0c0e] border border-[#27272a] rounded-[16px] p-6 sm:p-8 flex flex-col items-center justify-center space-y-4">
      <div class="w-14 h-14 rounded-2xl bg-[#141419] border border-[#27272a] flex items-center justify-center text-[#00dfd8] shadow-inner">
        <svg class="animate-spin h-7 w-7 text-[#00dfd8]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </div>
      <div class="text-center space-y-1">
        <div class="text-[16px] font-bold text-[#f4f4f5]">{t.loadingTitle}</div>
        <div class="text-[13px] text-[#71717a] font-mono">{t.loadingSubtitle}</div>
      </div>
    </div>
  </ChessEngineTool>
</div>
