---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const comparisons = [
  {
    feature: t('benefits.r1Cap'),
    legacy: t('benefits.r1Leg'),
    nextMove: t('benefits.r1Next'),
  },
  {
    feature: t('benefits.r2Cap'),
    legacy: t('benefits.r2Leg'),
    nextMove: t('benefits.r2Next'),
  },
  {
    feature: t('benefits.r3Cap'),
    legacy: t('benefits.r3Leg'),
    nextMove: t('benefits.r3Next'),
  },
  {
    feature: t('benefits.r4Cap'),
    legacy: t('benefits.r4Leg'),
    nextMove: t('benefits.r4Next'),
  },
];
---

<section class="w-full py-16 lg:py-24 border-b border-[#27272a]/60 bg-[#0a0a0a]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
      <Badge text={t('benefits.badge')} variant="mono" />
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#f4f4f5]">
        {t('benefits.title')}
      </h2>
      <p class="text-[15px] text-[#a1a1aa]">
        {t('benefits.desc')}
      </p>
    </div>

    <!-- Comparison Table Card -->
    <Card padding="none" class="overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="border-b border-[#27272a] bg-[#18181b]">
              <th class="p-4 sm:p-5 text-[#f4f4f5] font-semibold text-[14px]">{t('benefits.thCapability')}</th>
              <th class="p-4 sm:p-5 text-[#71717a] font-mono text-[13px] uppercase">{t('benefits.thLegacy')}</th>
              <th class="p-4 sm:p-5 text-[#00dfd8] font-mono text-[13px] uppercase bg-[#0070f3]/5 border-l border-[#27272a]">
                {t('benefits.thNextMove')}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#27272a]">
            {comparisons.map((item) => (
              <tr class="hover:bg-[#151518] transition-colors">
                <td class="p-4 sm:p-5 font-semibold text-[#f4f4f5]">{item.feature}</td>
                <td class="p-4 sm:p-5 text-[#71717a]">{item.legacy}</td>
                <td class="p-4 sm:p-5 text-[#f4f4f5] font-medium bg-[#0070f3]/5 border-l border-[#27272a]">
                  <span class="inline-flex items-center gap-1.5 text-[#00dfd8]">
                    <svg class="w-4 h-4 shrink-0 text-[#10b981]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item.nextMove}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>
  </div>
</section>
