---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
---

<section class="w-full py-20 lg:py-28 bg-[#0a0a0a] relative overflow-hidden text-center">
  <!-- Subtle Mesh Accent -->
  <div class="absolute inset-0 bg-mesh-gradient opacity-60 pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
    <Badge text="Start Winning More Games" variant="brand" />

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-[-0.03em] text-[#f4f4f5] leading-tight">
      Ready to Find Your <span class="text-gradient">Winning Next Move</span>?
    </h2>

    <p class="text-base sm:text-lg text-[#a1a1aa] max-w-xl mx-auto leading-relaxed">
      Analyze your current board, eliminate blunders, and calculate winning candidate moves in real time.
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/chess-next-move" variant="primary" class="w-full sm:w-auto shadow-[0_0_25px_rgba(255,255,255,0.2)]">
        Launch Chess Tool Now →
      </Button>
      <Button href="/learn" variant="secondary" class="w-full sm:w-auto">
        Read Strategy Guides
      </Button>
    </div>
  </div>
</section>
