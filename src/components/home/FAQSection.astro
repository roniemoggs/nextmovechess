  fr: [
    {
      q: 'Comment trouver le meilleur coup aux échecs ?',
      a: 'Placez vos pièces sur l’échiquier Next Move Chess ou collez un code FEN. Le moteur Stockfish NNUE calcule des millions de positions pour afficher les meilleurs coups candidats.',
    },
    {
      q: 'Quel est le meilleur coup d’ouverture aux échecs ?',
      a: '1.e4 et 1.d4 sont statistiquement les meilleurs premiers coups aux échecs pour les Blancs car ils contrôlent le centre immédiatement.',
    },
    {
      q: 'Quel est le moteur d’échecs le plus fort ?',
      a: 'Stockfish NNUE est universellement reconnu comme le moteur d’échecs le plus puissant au monde avec plus de 3500 Elo.',
    },
    {
      q: 'Ce calculateur d’échecs est-il gratuit ?',
      a: 'Oui, Next Move Chess est entièrement gratuit, sans inscription ni publicité intrusive.',
    },
  ],
  de: [
    {
      q: 'Wie finde ich den besten nächsten Schachzug?',
      a: 'Baue deine Stellung auf dem Schachbrett von Next Move Chess auf oder füge einen FEN-Code ein. Die Stockfish NNUE-Engine berechnet sofort die besten Kandidatenzüge.',
    },
    {
      q: 'Was ist der beste Eröffnungszug im Schach?',
      a: '1.e4 und 1.d4 sind statistisch die erfolgreichsten Eröffnungszüge im Schach für Weiß, um sofort das Zentrum zu beherrschen.',
    },
    {
      q: 'Welche Schach-Engine ist die stärkste der Welt?',
      a: 'Stockfish NNUE gilt mit über 3500 Elo als die stärkste Schach-Engine der Welt und läuft direkt in deinem Browser.',
    },
    {
      q: 'Ist dieser Schachzug-Rechner kostenlos?',
      a: 'Ja, Next Move Chess ist zu 100% kostenlos, ohne Anmeldung und werbefrei.',
    },
  ],
  ja: [
    {
      q: 'チェスで次の最善手を見つけるにはどうすればよいですか？',
      a: 'Next Move Chessの盤上に駒を配置するかFENコードを貼り付けてください。Stockfish NNUEエンジンが数百万局面を読み、最善の手順を即座に表示します。',
    },
    {
      q: 'チェスで最も強いエンジンは何ですか？',
      a: 'Stockfish NNUEが世界最強のチェスエンジンとして広く認知されており、レーティングは3500 Eloを超えています。',
    },
    {
      q: 'このチェス計算ツールは無料で使えますか？',
      a: 'はい、Next Move Chessは完全無料で、会員登録や広告の煩わしさも一切ありません。',
    },
  ],
  tr: [
    {
      q: 'Satrançta en iyi sonraki hamleyi nasıl bulabilirim?',
      a: 'Tahtaya taşları yerleştirin veya FEN kodunu yapıştırın. Stockfish NNUE satranç motoru saniyede milyonlarca konumu hesaplayarak en iyi hamleleri gösterir.',
    },
    {
      q: 'Dünyanın en güçlü satranç motoru hangisidir?',
      a: 'Stockfish NNUE, 3500+ üzeri Elo gücüyle dünyanın en güçlü satranç motoru olarak kabul edilir.',
    },
    {
      q: 'Bu satranç hesaplayıcı ücretsiz mi?',
      a: 'Evet, Next Move Chess tamamen ücretsizdir ve kayıt gerektirmez.',
    },
  ],
  id: [
    {
      q: 'Bagaimana cara menemukan langkah catur terbaik berikutnya?',
      a: 'Atur posisi di papan Next Move Chess atau tempel kode FEN. Mesin Stockfish NNUE akan menghitung jutaan variasi untuk menampilkan langkah catur terbaik.',
    },
    {
      q: 'Apa mesin catur terkuat di dunia?',
      a: 'Stockfish NNUE diakui sebagai mesin catur terkuat di dunia dengan perkiraan Elo di atas 3500+.',
    },
    {
      q: 'Apakah kalkulator catur ini gratis?',
      a: 'Ya, Next Move Chess 100% gratis tanpa perlu registrasi atau langganan apa pun.',
    },
  ],
  ko: [
    {
      q: '체스에서 다음 최선의 수를 어떻게 찾을 수 있나요?',
      a: 'Next Move Chess 체스판에 기물을 배치하거나 FEN 코드를 붙여넣으세요. Stockfish NNUE 엔진이 최적의 후보수와 수순을 즉시 계산합니다.',
    },
    {
      q: '세계에서 가장 강력한 체스 엔진은 무엇인가요?',
      a: 'Stockfish NNUE는 3500 이상의 레이팅을 기록하며 세계 최강의 체스 엔진으로 인정받고 있습니다.',
    },
    {
      q: '이 체스 계산기는 무료인가요?',
      a: '네, Next Move Chess는 회원가입이나 결제 없이 100% 무료로 이용하실 수 있습니다.',
    },
  ],
};

const currentFaqs = localizedFaqData[currentLang] || localizedFaqData.en;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: currentFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<section class="w-full py-16 lg:py-24 border-b border-[#27272a]/60 bg-[#0c0c0e]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14 space-y-3">
      <Badge text={t('faq.badge')} variant="mono" />
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#f4f4f5]">
        {t('faq.title')}
      </h2>
      <p class="text-[15px] text-[#a1a1aa]">
        {t('faq.desc')}
      </p>
    </div>

    <div class="space-y-4">
      {currentFaqs.map((faq) => (
        <Card class="p-5 sm:p-6">
          <details class="group cursor-pointer">
            <summary class="flex items-center justify-between font-semibold text-[16px] text-[#f4f4f5] list-none">
              <span>{faq.q}</span>
              <span class="w-6 h-6 rounded-full bg-[#18181b] border border-[#27272a] flex items-center justify-center text-[#a1a1aa] group-open:rotate-180 transition-transform text-xs shrink-0 ml-4">
                ▼
              </span>
            </summary>
            <p class="mt-3 text-[14px] text-[#a1a1aa] leading-relaxed pt-3 border-t border-[#27272a]/60">
              {faq.a}
            </p>
          </details>
        </Card>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href={translatePath('/faq')}
        class="inline-flex items-center gap-2 text-sm font-semibold text-[#00dfd8] hover:text-[#00dfd8]/80 transition-colors"
      >
        {t('homeLearn.viewAll')}
      </a>
    </div>
  </div>

  <!-- FAQ JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
