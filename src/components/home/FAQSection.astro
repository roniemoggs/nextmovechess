---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

// Localized FAQ items
const localizedFaqData: Record<SupportedLanguage, Array<{ q: string; a: string }>> = {
  en: [
    {
      q: 'How do I find the best next move in chess?',
      a: 'To find the best next move in chess, set up your position on Next Move Chess by dragging pieces or pasting a FEN/PGN code. The Stockfish NNUE engine calculates millions of possibilities per second to display the optimal candidate moves and numerical evaluations.',
    },
    {
      q: 'What is the best opening move in chess?',
      a: '1.e4 (King’s Pawn) and 1.d4 (Queen’s Pawn) are statistically and strategically the best opening moves in chess for White. They stake immediate central control and facilitate rapid piece development. 1.c4 (English) and 1.Nf3 (Réti) are also elite grandmaster choices.',
    },
    {
      q: 'What is the best move in my chess position?',
      a: 'The best move in your position depends on tactical factors (checks, captures, threats) and positional goals (king safety, piece activity). Input your position into Next Move Chess to receive the mathematically strongest move computed by our Stockfish chess AI.',
    },
    {
      q: 'What’s my next chess move?',
      a: 'Find your next chess move instantly by pasting your FEN string or playing moves on the analysis board. Next Move Chess highlights the highest-rated continuation with dynamic visual arrows and deep line evaluations.',
    },
    {
      q: 'What is a chess engine?',
      a: 'A chess engine is a specialized computer program that calculates chess moves and evaluates positions using minimax search trees, alpha-beta pruning, and neural evaluation networks (NNUE).',
    },
    {
      q: 'What is the strongest chess engine?',
      a: 'Stockfish (specifically Stockfish NNUE) is globally recognized as the strongest chess engine in the world, with an estimated Elo exceeding 3500+ and dominant victories in top computer chess championships.',
    },
    {
      q: 'Is this chess move calculator free to use?',
      a: 'Yes, Next Move Chess is 100% free with no registration, subscriptions, or paywalls required.',
    },
    {
      q: 'Is using a chess AI to find moves cheating?',
      a: 'Using a chess AI during a live game against another human player is considered cheating and violates fair play rules. However, using chess AI for post-game analysis, study, and training is completely fair and highly encouraged.',
    },
  ],
  'pt-br': [
    {
      q: 'Como encontrar a melhor próxima jogada no xadrez?',
      a: 'Monte a posição do seu jogo no Next Move Chess arrastando as peças ou colando o código FEN. A engine Stockfish NNUE avalia milhões de posições por segundo e indica as melhores jogadas de xadrez.',
    },
    {
      q: 'Qual é o melhor lance de abertura no xadrez?',
      a: 'Os lances 1.e4 e 1.d4 são estatisticamente as melhores jogadas de abertura no xadrez para as Brancas, disputando o centro imediatamente.',
    },
    {
      q: 'Qual é a melhor jogada na minha posição de xadrez?',
      a: 'A melhor jogada depende de fatores táticos e posicionais. Insira sua posição no Next Move Chess para obter o cálculo do lance ideal pela nossa IA de xadrez.',
    },
    {
      q: 'O que é uma engine de xadrez?',
      a: 'Uma engine de xadrez é um software especializado que calcula variantes de jogadas usando árvores minimax, poda alfa-beta e redes neurais (NNUE).',
    },
    {
      q: 'Qual é a engine de xadrez mais forte do mundo?',
      a: 'O Stockfish NNUE é reconhecido mundialmente como a engine de xadrez mais forte, com mais de 3500 de rating Elo.',
    },
    {
      q: 'Essa calculadora de xadrez é gratuita?',
      a: 'Sim, o Next Move Chess é 100% grátis, sem necessidade de cadastro, cartões ou assinaturas.',
    },
  ],
  es: [
    {
      q: '¿Cómo encontrar el mejor siguiente movimiento en ajedrez?',
      a: 'Coloca las piezas en el tablero de Next Move Chess o pega tu código FEN. El motor Stockfish NNUE calculará millones de variantes por segundo para mostrarte las mejores jugadas de ajedrez.',
    },
    {
      q: '¿Cuál es el mejor movimiento de apertura en ajedrez?',
      a: '1.e4 y 1.d4 son estadísticamente los mejores movimientos iniciales en ajedrez para las blancas, asegurando el control central inmediato.',
    },
    {
      q: '¿Cuál es la mejor jugada en mi posición de ajedrez?',
      a: 'La mejor jugada depende de la táctica y la estrategia. Introduce tu tablero en Next Move Chess y el motor de ajedrez calculará la mejor continuación.',
    },
    {
      q: '¿Qué es un motor de ajedrez?',
      a: 'Un motor de ajedrez es un programa informático diseñado para calcular jugadas y evaluar posiciones mediante algoritmos minimax y redes neuronales NNUE.',
    },
    {
      q: '¿Cuál es el motor de ajedrez más fuerte?',
      a: 'Stockfish NNUE es el motor de ajedrez más potente del mundo, con más de 3500 puntos Elo estimados.',
    },
    {
      q: '¿Es gratis esta calculadora de ajedrez?',
      a: 'Sí, Next Move Chess es 100% gratuita y no requiere registro ni suscripciones.',
    },
