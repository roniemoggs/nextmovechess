---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const features = [
  {
    title: t('features.f1Title'),
    desc: t('features.f1Desc'),
    badge: t('features.f1Badge'),
  },
  {
    title: t('features.f2Title'),
    desc: t('features.f2Desc'),
    badge: t('features.f2Badge'),
  },
  {
    title: t('features.f3Title'),
    desc: t('features.f3Desc'),
    badge: t('features.f3Badge'),
  },
  {
    title: t('features.f4Title'),
    desc: t('features.f4Desc'),
    badge: t('features.f4Badge'),
  },
  {
    title: t('features.f5Title'),
    desc: t('features.f5Desc'),
    badge: t('features.f5Badge'),
  },
  {
    title: t('features.f6Title'),
    desc: t('features.f6Desc'),
    badge: t('features.f6Badge'),
  },
];
---

<section class="w-full py-16 lg:py-24 border-b border-[#27272a]/60 bg-[#0c0c0e]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
      <Badge text={t('features.badge')} variant="brand" />
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#f4f4f5]">
        {t('features.title')}
      </h2>
      <p class="text-[15px] text-[#a1a1aa]">
        {t('features.desc')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <Card hoverEffect={true} class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono uppercase tracking-wider text-[#00dfd8] bg-[#00dfd8]/10 px-2 py-0.5 rounded border border-[#00dfd8]/20">
              {feature.badge}
            </span>
            <div class="w-2 h-2 rounded-full bg-[#27272a]"></div>
          </div>
          <h3 class="text-lg font-bold text-[#f4f4f5] tracking-tight">
            {feature.title}
          </h3>
          <p class="text-[14px] text-[#a1a1aa] leading-relaxed">
            {feature.desc}
          </p>
        </Card>
      ))}
    </div>
  </div>
</section>
