---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const steps = [
  {
    step: '01',
    title: t('how.step1Title'),
    desc: t('how.step1Desc'),
    tag: '01 / Setup',
  },
  {
    step: '02',
    title: t('how.step2Title'),
    desc: t('how.step2Desc'),
    tag: '02 / Engine',
  },
  {
    step: '03',
    title: t('how.step4Title'),
    desc: t('how.step4Desc'),
    tag: '03 / Strategy',
  },
];
---

<section class="w-full py-16 lg:py-24 border-b border-[#27272a]/60 bg-[#0a0a0a]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
      <Badge text={t('how.badge')} variant="mono" />
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#f4f4f5]">
        {t('how.title')}
      </h2>
      <p class="text-[15px] text-[#a1a1aa]">
        {t('how.desc')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {steps.map((item) => (
        <Card hoverEffect={true} class="relative overflow-hidden group">
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-bold font-mono text-[#27272a] group-hover:text-[#00dfd8] transition-colors">
              {item.step}
            </span>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#18181b] text-[#71717a] border border-[#27272a]">
              {item.tag}
            </span>
          </div>
          <h3 class="text-lg font-bold text-[#f4f4f5] mb-2 tracking-tight group-hover:text-[#ffffff]">
            {item.title}
          </h3>
          <p class="text-[14px] text-[#a1a1aa] leading-relaxed">
            {item.desc}
          </p>
        </Card>
      ))}
    </div>
  </div>
</section>
