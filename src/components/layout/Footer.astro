---
import Logo from '../ui/Logo.astro';
import LanguagePicker from '../ui/LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const year = new Date().getFullYear();
---

<footer class="w-full bg-[#0a0a0a] border-t border-[#27272a] mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand & Summary -->
      <div class="md:col-span-1 space-y-4">
        <a href={translatePath('/')} class="focus:outline-none" aria-label="Next Move Chess Home">
          <Logo size="md" />
        </a>
        <p class="text-[13px] text-[#a1a1aa] leading-relaxed">
          {t('footer.summary')}
        </p>
        
        <!-- Language selector in footer -->
        <div class="pt-2">
          <div class="text-[11px] font-mono text-[#71717a] mb-1.5 uppercase tracking-wider">{t('nav.selectLanguage')}</div>
          <LanguagePicker variant="full" />
        </div>

        <div class="text-[11px] font-mono text-[#71717a] pt-1">
          Domain: nextmovechesss.com
        </div>
      </div>

      <!-- Core Engine Tools -->
      <div class="space-y-3">
        <h4 class="text-[12px] font-mono font-medium uppercase tracking-wider text-[#a1a1aa]">
          {t('footer.engineTools')}
        </h4>
        <ul class="space-y-2 text-[13px]">
          <li>
            <a href={translatePath('/chess-next-move')} class="text-[#f4f4f5] hover:text-[#00dfd8] transition-colors font-medium">
              {t('footer.calcTool')}
            </a>
          </li>
          <li>
            <a href={translatePath('/chess-next-move')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.analysisBoard')}
            </a>
          </li>
          <li>
            <a href={translatePath('/how-it-works')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.archLink')}
            </a>
          </li>
          <li>
            <a href={translatePath('/chess-next-move')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.bestCalcLink')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Strategy & Education -->
      <div class="space-y-3">
        <h4 class="text-[12px] font-mono font-medium uppercase tracking-wider text-[#a1a1aa]">
          {t('footer.learnHeading')}
        </h4>
        <ul class="space-y-2 text-[13px]">
          <li>
            <a href={translatePath('/learn/how-to-find-the-best-move-in-chess')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.findBestMove')}
            </a>
          </li>
          <li>
            <a href={translatePath('/learn/chess-move-analyzer')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.evalGuide')}
            </a>
          </li>
          <li>
            <a href={translatePath('/learn/how-chess-engines-work')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.howEngineWorks')}
            </a>
          </li>
          <li>
            <a href={translatePath('/learn/chess-tactics-guide')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.tacticsGuide')}
            </a>
          </li>
          <li>
            <a href={translatePath('/learn/chess-opening-principles')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.openingRules')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Platform & Legal -->
      <div class="space-y-3">
        <h4 class="text-[12px] font-mono font-medium uppercase tracking-wider text-[#a1a1aa]">
          {t('footer.productLegal')}
        </h4>
        <ul class="space-y-2 text-[13px]">
          <li>
            <a href={translatePath('/about')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.aboutUs')}
            </a>
          </li>
          <li>
            <a href={translatePath('/faq')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.faq')}
            </a>
          </li>
          <li>
            <a href={translatePath('/contact')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.contact')}
            </a>
          </li>
          <li>
            <a href={translatePath('/privacy')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.privacy')}
            </a>
          </li>
          <li>
            <a href={translatePath('/terms')} class="text-[#a1a1aa] hover:text-[#f4f4f5] transition-colors">
              {t('footer.terms')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-[#27272a] flex flex-col sm:flex-row items-center justify-between gap-4 text-[12px] text-[#71717a]">
      <div>
        &copy; {year} Next Move Chess. {t('footer.rights')}
      </div>
      <div class="flex items-center gap-6">
        <a href={translatePath('/privacy')} class="hover:text-[#a1a1aa] transition-colors">{t('footer.privacy')}</a>
        <a href={translatePath('/terms')} class="hover:text-[#a1a1aa] transition-colors">{t('footer.terms')}</a>
        <a href={translatePath('/contact')} class="hover:text-[#a1a1aa] transition-colors">{t('footer.contact')}</a>
        <span class="font-mono text-[11px] text-[#00dfd8]">nextmovechesss.com</span>
      </div>
    </div>
  </div>
</footer>
