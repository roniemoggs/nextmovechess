---
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navLinks = [
  { name: 'Chess Tool', href: '/chess-next-move', isHero: true },
  { name: 'How It Works', href: '/how-it-works' },
  { name: 'Learn & Strategy', href: '/learn' },
  { name: 'FAQ', href: '/faq' },
  { name: 'About', href: '/about' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#0a0a0a]/80 backdrop-blur-md border-b border-[#27272a]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="focus:outline-none" aria-label="Next Move Chess Home">
      <Logo size="md" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 bg-[#121212] p-1 rounded-full border border-[#27272a]/80" aria-label="Main Navigation">
      {navLinks.map((link) => {
        const isActive = activePath === link.href || (link.href !== '/' && activePath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-colors ${
              isActive
                ? 'bg-[#27272a] text-[#f4f4f5]'
                : 'text-[#a1a1aa] hover:text-[#f4f4f5] hover:bg-[#18181b]'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA & Status -->
    <div class="hidden md:flex items-center gap-3">
      <div class="flex items-center gap-1.5 text-[12px] font-mono text-[#10b981] bg-[#10b981]/10 px-2.5 py-1 rounded-full border border-[#10b981]/20">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
        Engine Online
      </div>
      <Button href="/chess-next-move" variant="primary-sm" class="shadow-[0_0_15px_rgba(255,255,255,0.1)]">
        Analyze Position
      </Button>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden p-2 rounded-[6px] text-[#a1a1aa] hover:text-[#f4f4f5] hover:bg-[#18181b] border border-[#27272a] focus:outline-none"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#27272a] bg-[#0d0d0f] px-4 pt-3 pb-6 space-y-3">
    <div class="flex flex-col space-y-1">
      {navLinks.map((link) => {
        const isActive = activePath === link.href || (link.href !== '/' && activePath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2.5 rounded-[8px] text-[14px] font-medium flex items-center justify-between ${
              isActive
                ? 'bg-[#27272a] text-[#ffffff]'
                : 'text-[#a1a1aa] hover:bg-[#18181b] hover:text-[#f4f4f5]'
            }`}
          >
            {link.name}
            {link.isHero && (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#0070f3]/20 text-[#00dfd8] border border-[#0070f3]/30">
                Core Tool
              </span>
            )}
          </a>
        );
      })}
    </div>

    <div class="pt-3 border-t border-[#27272a] flex flex-col gap-2.5">
      <Button href="/chess-next-move" variant="primary" class="w-full justify-center">
        Analyze Position
      </Button>
      <div class="flex items-center justify-center gap-2 text-[12px] font-mono text-[#a1a1aa] pt-1">
        <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
        Stockfish Engine ready in browser
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileMenu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
