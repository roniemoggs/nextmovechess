---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  readTime: string;
  pubDate: Date;
  featured?: boolean;
  lang?: SupportedLanguage;
}

const { title, description, slug, category, readTime, pubDate, featured = false } = Astro.props;

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);

const formattedDate = new Intl.DateTimeFormat(currentLang === 'en' ? 'en-US' : currentLang, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);
---

<Card
  as="a"
  href={translatePath(`/learn/${slug}`)}
  hoverEffect={true}
  class={`group flex flex-col justify-between h-full p-6 ${
    featured ? 'border-[#0070f3]/40 bg-gradient-to-br from-[#121212] to-[#16161a]' : ''
  }`}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <Badge text={category} variant={featured ? 'brand' : 'mono'} />
      <span class="text-[11px] font-mono text-[#71717a]">{readTime}</span>
    </div>

    <h3 class="text-lg sm:text-xl font-bold text-[#f4f4f5] group-hover:text-[#00dfd8] transition-colors leading-snug mb-2">
      {title}
    </h3>

    <p class="text-[14px] text-[#a1a1aa] leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-[#27272a] flex items-center justify-between text-[12px] font-mono text-[#71717a]">
    <span>{formattedDate}</span>
    <span class="text-[#0070f3] group-hover:text-[#00dfd8] group-hover:translate-x-1 transition-all flex items-center gap-1 font-medium">
      Read Guide →
    </span>
  </div>
</Card>
