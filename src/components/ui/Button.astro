---
interface Props {
  variant?: 'primary' | 'secondary' | 'primary-sm' | 'ghost-sm' | 'category-pill' | 'icon-circular';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  id,
  target,
  rel,
  ariaLabel,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-[#0070f3] focus:ring-offset-2 focus:ring-offset-[#0a0a0a] disabled:opacity-50 disabled:cursor-not-allowed select-none';

const variantMap = {
  // Marketing pill (DESIGN.md {rounded.pill} 100px)
  primary: 'h-11 px-6 rounded-[100px] bg-[#f4f4f5] text-[#0a0a0a] hover:bg-[#ffffff] hover:shadow-[0_0_20px_rgba(255,255,255,0.2)] active:scale-[0.98] text-[15px] font-semibold tracking-tight',
  secondary: 'h-11 px-6 rounded-[100px] bg-[#121212] text-[#f4f4f5] border border-[#27272a] hover:border-[#3f3f46] hover:bg-[#18181b] active:scale-[0.98] text-[15px]',
  
  // App & Nav 6px square controls (DESIGN.md {rounded.sm} 6px)
  'primary-sm': 'h-9 px-3.5 rounded-[6px] bg-[#f4f4f5] text-[#0a0a0a] hover:bg-[#ffffff] text-[13px] font-medium active:scale-[0.98]',
  'ghost-sm': 'h-9 px-3.5 rounded-[6px] bg-[#121212] text-[#f4f4f5] border border-[#27272a] hover:border-[#3f3f46] hover:bg-[#18181b] text-[13px] font-medium active:scale-[0.98]',
  
  // Category Pill (DESIGN.md 64px)
  'category-pill': 'h-8 px-4 rounded-[64px] bg-[#121212] text-[#a1a1aa] hover:text-[#f4f4f5] border border-[#27272a] hover:border-[#3f3f46] text-[13px]',
  
  // Circular Icon (DESIGN.md {rounded.full})
  'icon-circular': 'h-10 w-10 rounded-full bg-[#121212] text-[#f4f4f5] border border-[#27272a] hover:border-[#3f3f46] hover:bg-[#18181b] active:scale-[0.95]',
};

const Element = href ? 'a' : 'button';
---

<Element
  href={href}
  type={!href ? type : undefined}
  id={id}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
  class={`${baseStyles} ${variantMap[variant]} ${className}`}
  {...rest}
>
  <slot name="left-icon" />
  <slot />
  <slot name="right-icon" />
</Element>
