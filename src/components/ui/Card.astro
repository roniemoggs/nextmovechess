---
interface Props {
  as?: 'div' | 'section' | 'article' | 'a';
  href?: string;
  class?: string;
  hoverEffect?: boolean;
  padding?: 'sm' | 'md' | 'lg' | 'none';
}

const {
  as: Component = 'div',
  href,
  class: className = '',
  hoverEffect = false,
  padding = 'md',
} = Astro.props;

const paddingMap = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const hoverStyles = hoverEffect
  ? 'hover:border-[#3f3f46] hover:bg-[#151518] hover:shadow-[0_4px_24px_rgba(0,0,0,0.4)] transition-all duration-200'
  : '';

const Element = href ? 'a' : Component;
---

<Element
  href={href}
  class={`block bg-[#121212] border border-[#27272a] rounded-[14px] ${paddingMap[padding]} ${hoverStyles} ${className}`}
>
  <slot />
</Element>
