---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : (typeof error === 'string' ? error : null);
---

<BaseLayout
  title="500 - Engine Calculation Error"
  description="An unexpected calculation error or internal server issue occurred. Our chess algorithms are recovering."
  activePath="/500"
  noindex={true}
>
  <div class="relative overflow-hidden w-full py-12 sm:py-20 lg:py-24">
    <!-- Ambient Background Glows (Amber / Rose warning tones) -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-gradient-to-b from-[#f5a623]/15 via-[#ff0080]/10 to-transparent blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 left-10 w-[300px] h-[300px] bg-[#f5a623]/5 blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-10">
      
      <!-- Graphic & Error Badge -->
      <div class="flex flex-col items-center space-y-6">
        <Badge text="Error 500 • Engine Overload" variant="brand" class="border-[#f5a623]/30 bg-[#f5a623]/10 text-[#f5a623]">
          <svg slot="icon" class="w-3.5 h-3.5 text-[#f5a623]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </Badge>

        <!-- Visual 500 Error King Motif -->
        <div class="relative group my-2">
          <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl bg-gradient-to-br from-[#1c1313] via-[#121212] to-[#0a0a0a] border border-[#f5a623]/30 shadow-[0_0_50px_rgba(245,166,35,0.15)] flex items-center justify-center relative overflow-hidden">
            <!-- Chessboard Mini Grid Backdrop with Amber Tints -->
            <div class="absolute inset-0 grid grid-cols-4 grid-rows-4 opacity-15">
              {Array.from({ length: 16 }).map((_, i) => {
                const isDark = (Math.floor(i / 4) + (i % 4)) % 2 === 1;
                return <div class={isDark ? 'bg-[#f5a623]' : 'bg-transparent'} />;
              })}
            </div>

            <!-- King / Cross Symbol with Warning Pulse -->
            <div class="relative z-10 flex flex-col items-center justify-center">
              <svg class="w-16 h-16 sm:w-20 sm:h-20 text-[#f5a623] drop-shadow-[0_0_15px_rgba(245,166,35,0.5)] transition-transform duration-300 group-hover:scale-105" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <!-- Crown / King Cross -->
                <path d="M12 2v4M10 4h4" stroke-linecap="round" />
                <path d="M5 21h14a2 2 0 0 0 2-2v-1a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v1a2 2 0 0 0 2 2z" fill="#f5a623" fill-opacity="0.2" />
                <path d="M6 16l2-8 4 4 4-4 2 8" stroke-linejoin="round" />
                <circle cx="12" cy="12" r="1.5" fill="#f5a623" />
              </svg>
            </div>

            <!-- Warning Ring Border -->
            <div class="absolute inset-0 rounded-2xl border border-[#f5a623]/20 pointer-events-none"></div>
          </div>

          <!-- Large 500 Watermark text -->
          <div class="absolute -top-4 -right-6 font-mono text-5xl sm:text-6xl font-black text-[#27272a]/70 select-none -z-0">
            500
          </div>
        </div>

        <!-- Typography Heading -->
        <div class="space-y-3 max-w-2xl">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#f4f4f5]">
            Engine Calculation Error
          </h1>
          <p class="text-base sm:text-lg text-[#a1a1aa] leading-relaxed">
            Our analysis engine encountered an unexpected deadlock or server-side calculation exception. The engine state has been paused to protect memory.
          </p>
        </div>

        {errorMessage && (
          <div class="max-w-xl w-full text-left p-3 rounded-lg bg-[#18181b] border border-[#27272a] text-[12px] font-mono text-[#ff0080] overflow-x-auto">
            <span class="text-[#71717a] mr-2">Trace:</span>
            <code>{errorMessage}</code>
          </div>
        )}
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <button
          id="reload-page-btn"
          type="button"
          class="inline-flex items-center justify-center font-medium transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-[#f5a623] focus:ring-offset-2 focus:ring-offset-[#0a0a0a] select-none h-11 px-6 rounded-[100px] bg-[#f5a623] text-[#0a0a0a] hover:bg-[#ffb84d] hover:shadow-[0_0_20px_rgba(245,166,35,0.3)] active:scale-[0.98] text-[15px] font-semibold tracking-tight cursor-pointer"
        >
          <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          Reload Position
        </button>

        <Button href="/chess-next-move" variant="secondary">
          <svg slot="left-icon" class="w-4 h-4 mr-2 text-[#a1a1aa]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Open Clean Chess Tool
        </Button>

        <Button href="/" variant="secondary">
          <svg slot="left-icon" class="w-4 h-4 mr-2 text-[#a1a1aa]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Home
        </Button>
      </div>

      <!-- Diagnostic Status Indicators -->
      <div class="pt-8 border-t border-[#27272a]/60 space-y-4 max-w-3xl mx-auto">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-[#71717a] font-mono text-left">
          System Diagnostics & Recovery Steps
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <Card class="p-4 text-left border-[#27272a] bg-[#121212]/80 space-y-1">
            <div class="flex items-center gap-2 text-[12px] font-mono text-[#10b981]">
              <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
              Client WASM
            </div>
            <div class="text-[13px] text-[#f4f4f5] font-medium">Local Threads Active</div>
            <p class="text-[11px] text-[#71717a]">Runs completely on your browser hardware.</p>
          </Card>

          <Card class="p-4 text-left border-[#27272a] bg-[#121212]/80 space-y-1">
            <div class="flex items-center gap-2 text-[12px] font-mono text-[#f5a623]">
              <span class="w-2 h-2 rounded-full bg-[#f5a623] animate-pulse"></span>
              Memory Guard
            </div>
            <div class="text-[13px] text-[#f4f4f5] font-medium">Auto-Cleared Hash</div>
            <p class="text-[11px] text-[#71717a]">Transposition table cache refreshed.</p>
          </Card>

          <Card class="p-4 text-left border-[#27272a] bg-[#121212]/80 space-y-1">
            <div class="flex items-center gap-2 text-[12px] font-mono text-[#00dfd8]">
              <span class="w-2 h-2 rounded-full bg-[#00dfd8]"></span>
              Zero Data Loss
            </div>
            <div class="text-[13px] text-[#f4f4f5] font-medium">No Logged Games</div>
            <p class="text-[11px] text-[#71717a]">Privacy and session state isolated.</p>
          </Card>
        </div>
      </div>

      <!-- Contact & Report -->
      <div class="pt-2 text-center text-[13px] text-[#71717a]">
        If this calculation error persists across position reloads, please{' '}
        <a href="/contact" class="text-[#f5a623] hover:underline font-medium">
          submit a bug report
        </a>{' '}
        with your FEN string.
      </div>

    </div>
  </div>

  <script>
    const reloadBtn = document.getElementById('reload-page-btn');
    if (reloadBtn) {
      reloadBtn.addEventListener('click', () => {
        window.location.reload();
      });
    }
  </script>
</BaseLayout>
