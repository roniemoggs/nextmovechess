---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  const targetLocales = Object.keys(languages).filter((l) => l !== defaultLang);
  return targetLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title={`${t('nav.contact')} - Next Move Chess`}
  description="Corrections, engine evaluation discrepancies, and bug reports are all welcome. Contact Next Move Chess support at support@nextmovechesss.com."
  keywords={t('meta.homeKeywords')}
  activePath={translatePath('/contact')}
  lang={lang}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 w-full">
    <!-- Breadcrumbs -->
    <div class="mb-8">
      <Breadcrumbs
        items={[
          { name: t('nav.contact') },
        ]}
      />
    </div>

    <!-- Main Header -->
    <div class="space-y-6">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[#f4f4f5]">
        {t('nav.contact')}
      </h1>

      <p class="text-base sm:text-lg text-[#a1a1aa] leading-relaxed max-w-2xl">
        Corrections, engine evaluation discrepancies, wrong matches and bug reports are all welcome — reports of positions it consistently gets wrong are the most useful thing you can send.
      </p>

      <!-- Email Card Box -->
      <div class="mt-6 rounded-2xl bg-[#121214] border border-[#27272a] p-5 sm:p-6 shadow-sm hover:border-[#3f3f46] transition-colors flex items-center justify-between gap-4">
        <div class="text-[15px] sm:text-base text-[#e4e4e7] flex items-center gap-2 flex-wrap">
          <span class="text-[#a1a1aa]">Email:</span>
          <a
            href="mailto:support@nextmovechesss.com"
            class="font-mono text-[#f4f4f5] hover:text-[#00dfd8] transition-colors underline-offset-4 hover:underline"
          >
            support@nextmovechesss.com
          </a>
        </div>

        <button
          id="copy-email-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-[#a1a1aa] bg-[#18181b] border border-[#27272a] hover:text-white hover:border-[#3f3f46] hover:bg-[#27272a] transition-all cursor-pointer flex-shrink-0"
          title="Copy email to clipboard"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-text">Copy</span>
        </button>
      </div>

      <p class="text-xs sm:text-sm text-[#71717a] pt-1">
        We typically respond within 24–48 hours. Feedback on moves, board interactions, and engine accuracy helps us improve.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const email = 'support@nextmovechesss.com';

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        copyText.textContent = 'Copied!';
        copyBtn.classList.add('text-[#00dfd8]', 'border-[#00dfd8]/40');
        setTimeout(() => {
          copyText.textContent = 'Copy';
          copyBtn.classList.remove('text-[#00dfd8]', 'border-[#00dfd8]/40');
        }, 2000);
      } catch (e) {
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy';
        }, 2000);
      }
    });
  }
</script>
