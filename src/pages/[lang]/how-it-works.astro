---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  const targetLocales = Object.keys(languages).filter((l) => l !== defaultLang);
  return targetLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title={t('meta.howTitle')}
  description={t('meta.howDesc')}
  keywords={t('meta.homeKeywords')}
  activePath={translatePath('/how-it-works')}
  lang={lang}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 w-full space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: t('nav.howItWorks') },
      ]}
    />

    <!-- Header -->
    <header class="space-y-4">
      <Badge text={t('how.badge')} variant="brand" />
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#f4f4f5] leading-tight">
        {t('how.title')}
      </h1>
      <p class="text-base sm:text-lg text-[#a1a1aa] leading-relaxed">
        {t('how.desc')}
      </p>
    </header>

    <!-- Detailed 4-Stage Breakdown -->
    <div class="space-y-6">
      <!-- Stage 1 -->
      <Card class="p-6 sm:p-8 space-y-4">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-[#0070f3]/15 text-[#00dfd8] flex items-center justify-center font-mono font-bold text-[14px]">
            1
          </span>
          <h2 class="text-xl font-bold text-[#f4f4f5]">{t('how.step1Title')}</h2>
        </div>
        <p class="text-[15px] text-[#a1a1aa] leading-relaxed">
          {t('how.step1Desc')}
        </p>
        <div class="p-4 rounded-[8px] bg-[#18181b] border border-[#27272a] font-mono text-[12px] text-[#a1a1aa]">
          FEN: <span class="text-[#00dfd8]">r1bqk2r/pppp1ppp/2n2n2/2b1p3/2B1P3/2N2N2/PPPP1PPP/R1BQK2R w KQkq - 4 5</span>
        </div>
      </Card>

      <!-- Stage 2 -->
      <Card class="p-6 sm:p-8 space-y-4">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-[#7928ca]/15 text-[#ff0080] flex items-center justify-center font-mono font-bold text-[14px]">
            2
          </span>
          <h2 class="text-xl font-bold text-[#f4f4f5]">{t('how.step2Title')}</h2>
        </div>
        <p class="text-[15px] text-[#a1a1aa] leading-relaxed">
          {t('how.step2Desc')}
        </p>
      </Card>

      <!-- Stage 3 -->
      <Card class="p-6 sm:p-8 space-y-4">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-[#00dfd8]/15 text-[#00dfd8] flex items-center justify-center font-mono font-bold text-[14px]">
            3
          </span>
          <h2 class="text-xl font-bold text-[#f4f4f5]">{t('how.step3Title')}</h2>
        </div>
        <p class="text-[15px] text-[#a1a1aa] leading-relaxed">
          {t('how.step3Desc')}
        </p>
      </Card>

      <!-- Stage 4 -->
      <Card class="p-6 sm:p-8 space-y-4">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-[#10b981]/15 text-[#10b981] flex items-center justify-center font-mono font-bold text-[14px]">
            4
          </span>
          <h2 class="text-xl font-bold text-[#f4f4f5]">{t('how.step4Title')}</h2>
        </div>
        <p class="text-[15px] text-[#a1a1aa] leading-relaxed">
          {t('how.step4Desc')}
        </p>
      </Card>
    </div>

    <!-- CTA Section -->
    <Card class="bg-gradient-to-br from-[#121212] to-[#18181b] p-8 text-center space-y-4 border-[#27272a]">
      <h3 class="text-2xl font-bold text-[#f4f4f5]">{t('how.ctaTitle')}</h3>
      <p class="text-[14px] text-[#a1a1aa] max-w-lg mx-auto">
        {t('how.ctaDesc')}
      </p>
      <Button href={translatePath('/chess-next-move')} variant="primary">
        {t('how.ctaBtn')}
      </Button>
    </Card>
  </div>
</BaseLayout>
