---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import HowItWorks from '../../components/home/HowItWorks.astro';
import Features from '../../components/home/Features.astro';
import Benefits from '../../components/home/Benefits.astro';
import SeoGuide from '../../components/home/SeoGuide.astro';
import FAQSection from '../../components/home/FAQSection.astro';
import CTASection from '../../components/home/CTASection.astro';
import ArticleCard from '../../components/learn/ArticleCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  const targetLocales = Object.keys(languages).filter((l) => l !== defaultLang);
  return targetLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const articles = await getCollection('learn');
const featuredArticles = articles.slice(0, 3);
---

<BaseLayout
  title={t('meta.homeTitle')}
  description={t('meta.homeDesc')}
  keywords={t('meta.homeKeywords')}
  activePath={translatePath('/')}
  lang={lang}
>
  <!-- Hero with Integrated Tool Preview in Target Language -->
  <Hero lang={lang} />

  <!-- 3-Step Process -->
  <HowItWorks lang={lang} />

  <!-- Features Grid -->
  <Features lang={lang} />

  <!-- Competitive Comparison -->
  <Benefits lang={lang} />

  <!-- In-Depth SEO Guide & Deep-Dive Analysis -->
  <SeoGuide lang={lang} />

  <!-- Educational Guides Section -->
  <section class="w-full py-16 lg:py-24 border-b border-[#27272a]/60 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div class="space-y-2">
          <Badge text={t('homeLearn.badge')} variant="brand" />
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#f4f4f5]">
            {t('homeLearn.title')}
          </h2>
          <p class="text-[15px] text-[#a1a1aa] max-w-xl">
            {t('homeLearn.desc')}
          </p>
        </div>
        <Button href={translatePath('/learn')} variant="secondary" class="shrink-0">
          {t('homeLearn.viewAll')}
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredArticles.map((article: any) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.id}
            category={article.data.category}
            readTime={article.data.readTime}
            pubDate={article.data.pubDate}
            featured={article.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection lang={lang} />

  <!-- Final CTA -->
  <CTASection lang={lang} />
</BaseLayout>
