---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const articles = await getCollection('learn');
  const targetLocales = Object.keys(languages).filter((l) => l !== defaultLang);

  const paths = [];
  for (const lang of targetLocales) {
    for (const entry of articles) {
      paths.push({
        params: { lang, slug: entry.id },
        props: { entry, lang },
      });
    }
  }

  return paths;
}

const { entry, lang } = Astro.props as { entry: any; lang: SupportedLanguage };
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  category={entry.data.category}
  readTime={entry.data.readTime}
  author={entry.data.author}
  lang={lang}
>
  <Content />
</ArticleLayout>
