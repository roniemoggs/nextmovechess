---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import ArticleCard from '../../../components/learn/ArticleCard.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { languages, defaultLang, type SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  const targetLocales = Object.keys(languages).filter((l) => l !== defaultLang);
  return targetLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const articles = await getCollection('learn');
articles.sort((a: any, b: any) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={t('meta.learnTitle')}
  description={t('meta.learnDesc')}
  keywords={t('meta.homeKeywords')}
  activePath={translatePath('/learn')}
  lang={lang}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 w-full space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: t('nav.learn') },
      ]}
    />

    <!-- Header -->
    <header class="space-y-4 max-w-3xl">
      <Badge text={t('homeLearn.badge')} variant="brand" />
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#f4f4f5] leading-tight">
        {t('homeLearn.title')}
      </h1>
      <p class="text-base sm:text-lg text-[#a1a1aa] leading-relaxed">
        {t('homeLearn.desc')}
      </p>
    </header>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article: any) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          slug={article.id}
          category={article.data.category}
          readTime={article.data.readTime}
          pubDate={article.data.pubDate}
          featured={article.data.featured}
        />
      ))}
    </div>

    <!-- Bottom Feature Card -->
    <div class="pt-8 border-t border-[#27272a]">
      <div class="bg-gradient-to-r from-[#121212] via-[#16161a] to-[#121212] border border-[#27272a] rounded-[16px] p-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl text-center md:text-left">
          <Badge text="Interactive Tool" variant="brand" />
          <h3 class="text-2xl font-bold text-[#f4f4f5]">{t('cta.title')}</h3>
          <p class="text-[14px] text-[#a1a1aa]">
            {t('cta.desc')}
          </p>
        </div>
        <Button href={translatePath('/chess-next-move')} variant="primary" class="shrink-0">
          {t('nav.analyzeBtn')} →
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
