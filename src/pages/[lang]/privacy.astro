---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  const targetLocales = Object.keys(languages).filter((l) => l !== defaultLang);
  return targetLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title={t('meta.privacyTitle')}
  description="Next Move Chess Privacy Policy. Understand how we protect user privacy and run client-side engine evaluations."
  activePath={translatePath('/privacy')}
  lang={lang}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 w-full space-y-10">
    <Breadcrumbs
      items={[
        { name: t('footer.privacy') },
      ]}
    />

    <header class="space-y-4">
      <Badge text="Legal & Privacy" variant="mono" />
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#f4f4f5]">
        {t('footer.privacy')}
      </h1>
      <p class="text-sm text-[#71717a] font-mono">
        Last updated: October 2026
      </p>
    </header>

    <Card class="p-6 sm:p-8 space-y-6 text-[#a1a1aa] leading-relaxed text-[15px]">
      <h2 class="text-xl font-bold text-[#f4f4f5]">1. Client-Side Processing & Privacy</h2>
      <p>
        Next Move Chess executes position calculations directly in your browser using WebAssembly. Your moves, board setups, and FEN strings are not stored on our servers.
      </p>

      <h2 class="text-xl font-bold text-[#f4f4f5]">2. Contact & Inquiries</h2>
      <p>
        If you have questions regarding this Privacy Policy, contact us at <a href="mailto:support@nextmovechesss.com" class="text-[#00dfd8] hover:underline font-mono">support@nextmovechesss.com</a>.
      </p>
    </Card>
  </div>
</BaseLayout>
