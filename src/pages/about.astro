---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Next Move Chess',
  description: 'Next Move Chess is a modern, high-speed, ad-free online chess engine, move calculator, and tactical analysis platform.',
  url: 'https://nextmovechesss.com/about',
  mainEntity: {
    '@type': 'Organization',
    name: 'Next Move Chess',
    url: 'https://nextmovechesss.com',
    logo: 'https://nextmovechesss.com/favicon-96x96.png',
    description: 'Empowering chess players worldwide with instant WebAssembly-powered Stockfish calculations, tactical depth, and zero distractions.',
    knowsAbout: [
      'Chess Strategy',
      'Stockfish Engine',
      'Tactical Analysis',
      'Chess Openings',
      'Chess Position Evaluation',
      'WebAssembly Chess Engine'
    ]
  }
};
---

<BaseLayout
  title="About Us - Next Move Chess | Modern Chess Engine & Move Calculator"
  description="Learn about Next Move Chess — our mission to deliver the fastest, ad-free online chess engine, next move calculator, and tactical learning platform."
  keywords="about next move chess, chess ai, chess move calculator, chess engine online, stockfish chess engine, next move chess, chess analysis tool"
  activePath="/about"
  schema={aboutSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 w-full space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: 'About Us' },
      ]}
    />

    <!-- Header Section with Mesh Gradient -->
    <header class="space-y-4 text-left">
      <Badge text="About Next Move Chess" variant="brand" />
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#f4f4f5] leading-tight">
        Modern Chess Analysis Built for Speed, Clarity, and Learning
      </h1>
      <p class="text-base sm:text-lg text-[#a1a1aa] leading-relaxed max-w-3xl">
        Next Move Chess (<span class="font-mono text-[#00dfd8]">nextmovechesss.com</span>) was created to rethink how chess players evaluate positions, discover tactical breakthroughs, and study candidate moves online.
      </p>
    </header>

    <!-- Key Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <Card class="p-4 sm:p-5 text-center space-y-1 border-[#27272a] bg-[#121212]">
        <div class="text-2xl sm:text-3xl font-bold text-[#f4f4f5] font-mono">0ms</div>
        <div class="text-[12px] text-[#a1a1aa] font-medium">Server Latency (Local WASM)</div>
      </Card>
      <Card class="p-4 sm:p-5 text-center space-y-1 border-[#27272a] bg-[#121212]">
        <div class="text-2xl sm:text-3xl font-bold text-[#00dfd8] font-mono">NNUE</div>
        <div class="text-[12px] text-[#a1a1aa] font-medium">Stockfish Neural Eval</div>
      </Card>
      <Card class="p-4 sm:p-5 text-center space-y-1 border-[#27272a] bg-[#121212]">
        <div class="text-2xl sm:text-3xl font-bold text-[#10b981] font-mono">100%</div>
        <div class="text-[12px] text-[#a1a1aa] font-medium">Ad-Free & Free Access</div>
      </Card>
      <Card class="p-4 sm:p-5 text-center space-y-1 border-[#27272a] bg-[#121212]">
        <div class="text-2xl sm:text-3xl font-bold text-[#f5a623] font-mono">Private</div>
        <div class="text-[12px] text-[#a1a1aa] font-medium">Zero Position Logging</div>
      </Card>
    </div>

    <!-- Main Content Sections -->
    <div class="space-y-8 text-[15px] text-[#a1a1aa] leading-relaxed">
      <!-- Why We Built It -->
      <Card class="p-6 sm:p-8 space-y-4 border-[#27272a]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
          <h2 class="text-xl sm:text-2xl font-bold text-[#f4f4f5]">The Story Behind Next Move Chess</h2>
        </div>
        <p>
          For decades, online chess calculators and analysis boards have been burdened with clunky interfaces, intrusive banner advertisements, video popups, and slow round-trip server calculations. Players who simply wanted to evaluate a tricky middlegame position or verify an opening continuation had to navigate paywalls, rate limits, or slow interfaces.
        </p>
        <p>
          We built <strong class="text-[#f4f4f5]">Next Move Chess</strong> with a single guiding mission: to provide a sleek, instant, beautifully engineered chess tool that feels like a modern SaaS product. By bringing the world’s strongest open-source engine directly into your web browser via WebAssembly (WASM), we eliminate server lag and respect user privacy while offering grandmaster-level evaluation on demand.
        </p>
      </Card>

      <!-- Four Core Pillars -->
      <div class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#f4f4f5]">Our Core Principles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <Card class="p-6 space-y-3 border-[#27272a] hoverEffect">
            <div class="w-10 h-10 rounded-lg bg-[#0070f3]/10 border border-[#0070f3]/20 flex items-center justify-center text-[#00dfd8]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#f4f4f5]">1. Instant Client-Side Computation</h3>
            <p class="text-[14px] leading-relaxed text-[#a1a1aa]">
              Calculation happens directly on your machine's CPU using dedicated WebAssembly threads and Web Workers. There are no server queues, no waiting in line, and no latency drops.
            </p>
          </Card>

          <Card class="p-6 space-y-3 border-[#27272a] hoverEffect">
            <div class="w-10 h-10 rounded-lg bg-[#10b981]/10 border border-[#10b981]/20 flex items-center justify-center text-[#10b981]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#f4f4f5]">2. Total Position Privacy</h3>
            <p class="text-[14px] leading-relaxed text-[#a1a1aa]">
              Your game preparation, novelties, and private study positions never leave your device. Because calculations run locally, we never store or inspect your FEN positions on remote databases.
            </p>
          </Card>

          <Card class="p-6 space-y-3 border-[#27272a] hoverEffect">
            <div class="w-10 h-10 rounded-lg bg-[#7928ca]/10 border border-[#7928ca]/20 flex items-center justify-center text-[#c084fc]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#f4f4f5]">3. Distraction-Free Design</h3>
            <p class="text-[14px] leading-relaxed text-[#a1a1aa]">
              Chess requires deep focus. Our interface features an uncluttered dark theme, clear typography, responsive drag-and-drop board ergonomics, and absolutely zero intrusive popups.
            </p>
          </Card>

          <Card class="p-6 space-y-3 border-[#27272a] hoverEffect">
            <div class="w-10 h-10 rounded-lg bg-[#f5a623]/10 border border-[#f5a623]/20 flex items-center justify-center text-[#f5a623]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#f4f4f5]">4. Educational Insight</h3>
            <p class="text-[14px] leading-relaxed text-[#a1a1aa]">
              We don't just provide engine arrows; we build guides and explain the underlying strategic concepts behind evaluations — from outpost knights to pawn structure weaknesses and mating patterns.
            </p>
          </Card>
        </div>
      </div>

      <!-- Technology & Open Source Attribution -->
      <Card class="p-6 sm:p-8 space-y-4 border-[#27272a]">
        <h2 class="text-xl sm:text-2xl font-bold text-[#f4f4f5]">Engine Technology & Open Source</h2>
        <p>
          Next Move Chess is powered by the renowned <strong class="text-[#f4f4f5]">Stockfish</strong> chess engine compiled to WebAssembly. Stockfish is the strongest chess engine in the world, developed collaboratively by an international community of grandmasters, software engineers, and researchers.
        </p>
        <p>
          Stockfish is distributed under the <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noopener noreferrer" class="text-[#00dfd8] hover:underline">GNU General Public License (GPL v3)</a>. We proudly support and credit the open-source chess community for making state-of-the-art computational chess accessible to all.
        </p>
      </Card>

      <!-- Fair Play & Ethics -->
      <Card class="p-6 sm:p-8 space-y-4 border-[#27272a] bg-[#18181b]/60">
        <h2 class="text-xl sm:text-2xl font-bold text-[#f4f4f5]">Fair Play & Ethical Commitment</h2>
        <p>
          Next Move Chess is strictly designed for post-game analysis, solo study, training, puzzle solving, and opening preparation. We strongly condemn the use of chess calculation engines during live competitive matches on platforms such as Chess.com, Lichess, or FIDE-rated events. We encourage all players to preserve the competitive integrity and beauty of the game.
        </p>
      </Card>
    </div>

    <!-- CTA Section -->
    <Card class="bg-gradient-to-br from-[#121212] via-[#151518] to-[#1a1a24] p-8 sm:p-10 text-center space-y-6 border-[#27272a]">
      <div class="space-y-2">
        <h3 class="text-2xl sm:text-3xl font-bold text-[#f4f4f5]">Ready to Calculate Your Next Move?</h3>
        <p class="text-[14px] sm:text-base text-[#a1a1aa] max-w-xl mx-auto">
          Set up any position, import a FEN, or test candidate lines with instantaneous grandmaster evaluation.
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/chess-next-move" variant="primary">
          Launch Chess Calculator →
        </Button>
        <Button href="/learn" variant="secondary">
          Explore Strategy Guides
        </Button>
      </div>
    </Card>
  </div>
</BaseLayout>
