---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Next Move Chess Support & Feedback',
  description: 'Get in touch with the Next Move Chess team for engine feedback, bug reports, feature suggestions, and general inquiries.',
  url: 'https://nextmovechesss.com/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'Next Move Chess',
    url: 'https://nextmovechesss.com',
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'support@nextmovechesss.com',
      contactType: 'customer support',
      availableLanguage: ['English']
    }
  }
};
---

<BaseLayout
  title="Contact Us - Next Move Chess Support & Feedback"
  description="Get in touch with Next Move Chess. Send feature requests, bug reports, engine feedback, or general inquiries to our development team."
  keywords="contact next move chess, chess engine support, chess move calculator feedback, report chess bug"
  activePath="/contact"
  schema={contactSchema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 w-full space-y-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { name: 'Contact Us' },
      ]}
    />

    <!-- Header Section -->
    <header class="space-y-4 max-w-3xl">
      <Badge text="Get in Touch" variant="brand" />
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#f4f4f5] leading-tight">
        We'd Love to Hear From You
      </h1>
      <p class="text-base sm:text-lg text-[#a1a1aa] leading-relaxed">
        Have a feature request, spotted a chess engine evaluation discrepancy, or want to say hello? Send us a message and our team will get back to you promptly.
      </p>
    </header>

    <!-- Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Contact Methods & FAQ Shortcut -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Direct Email Card -->
        <Card class="p-6 space-y-4 border-[#27272a] bg-[#121212]">
          <div class="w-10 h-10 rounded-lg bg-[#0070f3]/10 border border-[#0070f3]/20 flex items-center justify-center text-[#00dfd8]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-lg font-bold text-[#f4f4f5]">Direct Support Email</h3>
            <p class="text-[13px] text-[#a1a1aa]">
              For detailed bug reports or partnership inquiries:
            </p>
            <a href="mailto:support@nextmovechesss.com" class="inline-block text-[#00dfd8] font-mono text-sm hover:underline pt-1">
              support@nextmovechesss.com
            </a>
          </div>
          <div class="text-[12px] text-[#71717a] font-mono pt-2 border-t border-[#27272a] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
            Average response time: &lt; 24-48 hours
          </div>
        </Card>

        <!-- Quick FAQs Box -->
        <Card class="p-6 space-y-4 border-[#27272a] bg-[#121212]">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-[#f4f4f5]">Frequently Asked</h3>
            <a href="/faq" class="text-xs text-[#00dfd8] hover:underline">View All FAQs →</a>
          </div>
          
          <div class="space-y-3 text-[13px]">
            <div class="space-y-1 border-b border-[#27272a]/60 pb-3">
              <div class="font-medium text-[#f4f4f5]">Is Next Move Chess free to use?</div>
              <p class="text-[#a1a1aa]">Yes, 100% free with unlimited analysis and full engine depths without registration.</p>
            </div>
            <div class="space-y-1 border-b border-[#27272a]/60 pb-3">
              <div class="font-medium text-[#f4f4f5]">Why does the engine run locally?</div>
              <p class="text-[#a1a1aa]">It runs via WebAssembly inside your browser for zero latency and total position privacy.</p>
            </div>
            <div class="space-y-1">
              <div class="font-medium text-[#f4f4f5]">Can I paste custom FEN / PGN?</div>
              <p class="text-[#a1a1aa]">Yes, simply paste any standard FEN string or drag pieces onto the board directly.</p>
            </div>
          </div>
        </Card>
      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <Card class="p-6 sm:p-8 space-y-6 border-[#27272a] bg-[#121212]">
          <div class="space-y-1">
            <h2 class="text-xl sm:text-2xl font-bold text-[#f4f4f5]">Send us a Message</h2>
            <p class="text-[14px] text-[#a1a1aa]">
              Fill out the form below and our chess engineering team will review it.
            </p>
          </div>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-[13px] font-medium text-[#f4f4f5] mb-1.5">
                  Your Name <span class="text-[#00dfd8]">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Alex Smith"
                  class="w-full bg-[#18181b] border border-[#27272a] rounded-[8px] px-3.5 py-2.5 text-[14px] text-[#f4f4f5] placeholder-[#71717a] focus:outline-none focus:border-[#0070f3] focus:ring-1 focus:ring-[#0070f3] transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-[13px] font-medium text-[#f4f4f5] mb-1.5">
                  Email Address <span class="text-[#00dfd8]">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="alex@example.com"
                  class="w-full bg-[#18181b] border border-[#27272a] rounded-[8px] px-3.5 py-2.5 text-[14px] text-[#f4f4f5] placeholder-[#71717a] focus:outline-none focus:border-[#0070f3] focus:ring-1 focus:ring-[#0070f3] transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-[13px] font-medium text-[#f4f4f5] mb-1.5">
                Topic / Subject <span class="text-[#00dfd8]">*</span>
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full bg-[#18181b] border border-[#27272a] rounded-[8px] px-3.5 py-2.5 text-[14px] text-[#f4f4f5] focus:outline-none focus:border-[#0070f3] focus:ring-1 focus:ring-[#0070f3] transition-colors"
              >
                <option value="feature">💡 Feature Suggestion</option>
                <option value="engine">⚡ Stockfish Engine / Evaluation Query</option>
                <option value="bug">🐛 Bug Report / Board Glitch</option>
                <option value="guide">📚 Learn & Strategy Content Feedback</option>
                <option value="business">🤝 Partnership / Business Inquiry</option>
                <option value="other">💬 General Question</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-[13px] font-medium text-[#f4f4f5] mb-1.5">
                Message <span class="text-[#00dfd8]">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Share your thoughts, feature ideas, or paste a FEN position if you are reporting an issue..."
                class="w-full bg-[#18181b] border border-[#27272a] rounded-[8px] px-3.5 py-2.5 text-[14px] text-[#f4f4f5] placeholder-[#71717a] focus:outline-none focus:border-[#0070f3] focus:ring-1 focus:ring-[#0070f3] transition-colors resize-none"
              ></textarea>
            </div>

            <div class="pt-2">
              <Button type="submit" id="submit-btn" variant="primary" class="w-full justify-center">
                Send Message →
              </Button>
            </div>
          </form>

          <!-- Success Message State -->
          <div id="contact-success" class="hidden p-6 rounded-[10px] bg-[#10b981]/10 border border-[#10b981]/30 text-center space-y-3">
            <div class="w-12 h-12 mx-auto rounded-full bg-[#10b981]/20 flex items-center justify-center text-[#10b981]">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#f4f4f5]">Thank You for Your Feedback!</h3>
            <p class="text-[14px] text-[#a1a1aa] max-w-sm mx-auto">
              Your message has been received. Our team will review your inquiry and follow up shortly.
            </p>
            <div class="pt-2">
              <Button id="reset-btn" variant="secondary" class="text-xs">
                Send Another Note
              </Button>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('contact-success');
  const resetBtn = document.getElementById('reset-btn');

  if (form && successMsg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
    });
  }

  if (resetBtn && form && successMsg) {
    resetBtn.addEventListener('click', () => {
      form.reset();
      successMsg.classList.add('hidden');
      form.classList.remove('hidden');
    });
  }
</script>
